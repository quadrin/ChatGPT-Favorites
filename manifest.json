{
  "name": "ChatGPT-Favorites",
  "version": "1.1",
  "description": "Adds ability to favorite chat logs and messages to ChatGPT, and read them offline",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage", "unlimitedStorage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": {
    "default_title": "Saved favorites (works offline)",
    "default_popup": "offline.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["common.js", "offlineSync.js", "contentScript.js", "messageFavoriting.js"]
    }
  ]
}
